# Format : postgresql://<user>:<password>@<host>:<port>/<nom_de_la_base>
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/community_db

# Clé secrète pour signer les tokens JWT (mets une longue chaîne aléatoire)
JWT_SECRET_KEY=projet-community-db-egoss-arsen
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440